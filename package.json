{
  "name": "relojeria-ia-monorepo",
  "version": "13.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-apps.mjs dev",
    "dev:web": "npm run dev --workspace=@relojeria/web",
    "dev:admin": "npm run dev --workspace=@relojeria/admin",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@relojeria/web",
    "build:admin": "npm run build --workspace=@relojeria/admin",
    "start": "node scripts/run-apps.mjs start",
    "start:web": "npm run start --workspace=@relojeria/web",
    "start:admin": "npm run start --workspace=@relojeria/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "lucide-react": "^1.6.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
